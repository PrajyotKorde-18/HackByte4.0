{
  "manifest_version": 3,
  "name": "PromptBridge AI Middleware",
  "version": "1.0.0",
  "description": "Advanced AI input/output optimization for ChatGPT, Claude, and Gemini.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8001/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["src/content/content.js"]
    }
  ],
  "background": {
    "service_worker": "src/background/background.js"
  }
}
